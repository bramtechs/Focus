{
  "name": "@focus/dns-server",
  "version": "0.1.0",
  "private": true,
  "description": "Network-wide Focus: a DNS server that blocks distracting domains with @focus/site-blocker, plus a web dashboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "bin": { "focus-dns": "./dist/main.js" },
  "engines": { "node": ">=20" },
  "scripts": {
