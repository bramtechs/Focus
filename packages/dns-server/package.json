  },
  "dependencies": {
    "@focus/site-blocker": "*",
    "dns2": "^3.1.1",
    "fastify": "^5.6.0",
    "lowdb": "^7.0.1",
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
