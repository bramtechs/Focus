{
  "name": "@focus/site-blocker",
  "version": "0.1.0",
  "description": "Platform-agnostic site-blocking core: Jev/OpenRouter classification, allow/block lists, caching and threshold logic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
